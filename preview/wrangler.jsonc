{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "recharge-preview",
  "main": "worker.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "assets": {
    "directory": "../preview-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
