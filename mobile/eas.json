{
  "cli": { "version": ">=24.10.0", "appVersionSource": "local" },
  "build": {
    "preview-ios": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_NO_TELEMETRY": "1" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": false,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "RECHARGE_LIVE_ONLY": "1",
        "EXPO_PUBLIC_WORKSPACE_API_ORIGIN": "https://app.rechargegroup.co.uk",
        "EXPO_PUBLIC_ACCOUNT_API_URL": "https://app.rechargegroup.co.uk"
      }
    },
    "pilot": {
      "distribution": "internal",
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "RECHARGE_LIVE_ONLY": "1",
        "EXPO_PUBLIC_WORKSPACE_API_ORIGIN": "https://app.rechargegroup.co.uk",
        "EXPO_PUBLIC_ACCOUNT_API_URL": "https://app.rechargegroup.co.uk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
